# -------------------------------------------------------------
# NovaDrop Production Platform Environment Configuration
# -------------------------------------------------------------

# Application Environment
NODE_ENV=production
PORT=5000
APP_NAME="NovaDrop Enterprise Dropshipping"
APP_URL="https://novadrop.io"

# Database Configuration
DATABASE_URL="sqlite:////root/dropship_platform/dropship.db"
# If using PostgreSQL / Supabase in production:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Security & Authentication Secrets
JWT_SECRET="super-secret-dropship-platform-key-production-2026"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=72

# Payment Provider Configuration (Stripe / PayPal)
PAYMENT_PROVIDER="stripe"
PAYMENT_PUBLIC_KEY="pk_live_51M..."
PAYMENT_SECRET_KEY="sk_live_51M..."
PAYMENT_WEBHOOK_SECRET="whsec_mock_webhook_secret_key_2026"

# Supplier API Credentials (Isolated securely on server)
SUPPLIER_APEX_API_KEY="apex_sec_key_live_2026"
SUPPLIER_APEX_ENDPOINT="https://api.apextech.com/v2/dropship"
SUPPLIER_NORDIC_API_KEY="nordic_sec_key_live_2026"
SUPPLIER_NORDIC_ENDPOINT="https://api.nordiclogistics.eu/v1"

# Object Storage for Product & Review Photos (S3 / Cloudflare R2 / Supabase)
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_BUCKET="novadrop-product-media"
STORAGE_ACCESS_KEY="AKIA..."
STORAGE_SECRET_KEY="sec_..."

# Email Service (SendGrid / Resend)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG..."
FROM_EMAIL="orders@novadrop.io"
