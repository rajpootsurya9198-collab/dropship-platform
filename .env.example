# =============================================================
# NovaDrop Enterprise Platform — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL CREDENTIALS.
# NEVER COMMIT .env CONTAINING REAL SECRETS TO SOURCE CONTROL.
# =============================================================

# -------------------------------------------------------------
# APP CONFIGURATION
# -------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
ENV=production
PORT=5000
APP_NAME="NovaDrop Enterprise Dropshipping Platform"
APP_URL="https://your-backend.example.com"

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Local Development (SQLite):
# DATABASE_URL="sqlite:///dropship.db"
# Production (Managed PostgreSQL on Render, Supabase, Neon, AWS RDS):
DATABASE_URL="postgresql://username:password@hostname:5432/database_name"

# -------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -------------------------------------------------------------
# JWT signing secret (MUST be >= 16 characters; production aborts startup if missing or insecure default)
JWT_SECRET="your-strong-random-jwt-secret-minimum-32-chars-change-me"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=72

# -------------------------------------------------------------
# CORS CONFIGURATION
# -------------------------------------------------------------
# Comma-separated list of allowed frontend origins (GitHub Pages domain, custom domain, local dev)
CORS_ORIGINS="https://rajpootsurya9198-collab.github.io,http://localhost:5000"

# -------------------------------------------------------------
# PAYMENTS CONFIGURATION (Isolated on Server, Never Exposed to Frontend)
# -------------------------------------------------------------
# Provider options: "mock" (development sandbox) or "stripe"
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY="pk_test_sample_public_key_for_client"
PAYMENT_SECRET_KEY="sk_test_sample_secret_key_server_only"
PAYMENT_WEBHOOK_SECRET="whsec_sample_stripe_webhook_secret_key"

# -------------------------------------------------------------
# SUPPLIERS CREDENTIALS (Secure Warehouse Dispatch & Tracking)
# -------------------------------------------------------------
SUPPLIER_APEX_API_KEY="apex_api_credential_key"
SUPPLIER_APEX_ENDPOINT="https://api.apextech.com/v2/dropship"
SUPPLIER_NORDIC_API_KEY="nordic_api_credential_key"
SUPPLIER_NORDIC_ENDPOINT="https://api.nordiclogistics.eu/v1"
SUPPLIER_WEBHOOK_SECRET="whsec_supplier_milestone_webhook_secret"

# -------------------------------------------------------------
# STORAGE CREDENTIALS (S3 / Cloudflare R2 / MinIO for Product Media)
# -------------------------------------------------------------
STORAGE_PROVIDER="s3"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_BUCKET="novadrop-product-media"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="your-storage-access-key-id"
STORAGE_SECRET_KEY="your-storage-secret-access-key"

# -------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP / Transactional Email Notifications)
# -------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-smtp-api-key-or-password"
SMTP_FROM_EMAIL="orders@novadrop.io"
